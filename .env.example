# CalDef environment variables — NAMES ONLY.
# Copy to .env.local and fill in real values there. .env.local is
# gitignored and must never be committed.

# --- Public (safe in the browser; RLS is what protects them) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only. NEVER prefix these with NEXT_PUBLIC_. --------------
# Read in route handlers / server actions / server components only.
GEMINI_API_KEY=
USDA_API_KEY=

# Optional. Overrides the pinned Gemini model. Leave empty for the
# default, which is chosen for its free-tier allowance — see the note in
# src/lib/llm/gemini.ts before changing it.
GEMINI_MODEL=

# The Supabase service_role key is deliberately not used by this app.

# Who may create an account. Comma-separated addresses; unset means nobody,
# which is deliberate — see lib/signup-allowlist.ts. Sign-in is unaffected.
SIGNUP_ALLOWLIST=
