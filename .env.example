# CalDef environment variables — NAMES ONLY.
# Copy to .env.local and fill in real values there. .env.local is
# gitignored and must never be committed.

# --- Public (safe in the browser; RLS is what protects them) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only. NEVER prefix these with NEXT_PUBLIC_. --------------
# Read in route handlers / server actions / server components only.
GEMINI_API_KEY=
USDA_API_KEY=

# The Supabase service_role key is deliberately not used by this app.
